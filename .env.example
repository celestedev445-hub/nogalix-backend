APP_NAME=Nogalix
APP_ENV=local
# Set APP_DEBUG=false in production (hides /docs and detailed errors)
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nogalix
DB_USERNAME=root
DB_PASSWORD=

# Opaque token TTL (minutes) — style Sanctum
AUTH_TOKEN_TTL_MINUTES=1440

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=nogalix

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@nogalix.com
MAIL_FROM_NAME=Nogalix
CONTACT_TO_EMAIL=contact@nogalix.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false
GEMINI_MAX_OUTPUT_TOKENS=512

ASSISTANT_NAME=Noga

# Comma-separated bootstrap emails promoted to role=admin on login (optional)
ADMIN_EMAILS=

# ONLYOFFICE Document Server (Word-like editing for imported CVs)
# Run: docker compose -f docker-compose.onlyoffice.yml up -d
ONLYOFFICE_URL=http://localhost:8082
ONLYOFFICE_JWT_SECRET=
# URL reachable FROM the OnlyOffice container (host API)
APP_INTERNAL_URL=http://host.docker.internal:8010
IMPORT_ACCESS_SECRET=

# Adzuna - offres d'emploi (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# RapidAPI - JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_COUNTRY=fr
